# Port Mapping
FASHION_API_PORT=8011
SQUAT_API_PORT=8012

# Volume Roots (Local Paths)
# On your server, update these to the permanent project directory paths
FASHION_MODEL_ROOT=./models/fashion/current
SQUAT_MODEL_ROOT=./models/squat/current
SQUAT_SAMPLE_ROOT=./data/squat/samples

# Application Settings
FASHION_CORS_ORIGINS=https://obadaalsehli.com,http://localhost:3000
SQUAT_CORS_ORIGINS=https://obadaalsehli.com,http://localhost:3000

# Optional: Override images for local builds
# FASHION_API_IMAGE=fashion-prod-ready-fashion-api:latest
# SQUAT_API_IMAGE=squat-prod-ready-squat-api:latest

